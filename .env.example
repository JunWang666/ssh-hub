# Keep this as localhost when using the published port directly.
# For a remote deployment, set your public HTTPS origin (without a trailing slash)
# and put an HTTPS reverse proxy in front of SSH Hub.
SSHHUB_PUBLIC_URL=http://localhost:8080
SSHHUB_PORT=8080
# Optional separate Pangolin-protected admin origin; register its OIDC callback too.
# SSHHUB_ADMIN_URL=https://sshadmin.example.com

# Optional. If omitted on first boot, use the one-time setup token printed in logs.
# SSHHUB_ADMIN_PASSWORD=replace-with-at-least-12-characters

# Optional generic OpenID Connect login (works with Keycloak, Auth0, Google, Entra ID, etc.).
# Register this exact redirect URI with the identity provider:
#   ${SSHHUB_PUBLIC_URL}/auth/oidc/callback
# At least one allowlist must match a verified email or an exact OIDC subject.
# SSHHUB_OIDC_ISSUER=https://id.example.com/realms/ssh-hub
# SSHHUB_OIDC_CLIENT_ID=ssh-hub
# SSHHUB_OIDC_CLIENT_SECRET=replace-with-client-secret
# SSHHUB_OIDC_ALLOWED_EMAILS=admin@example.com
# SSHHUB_OIDC_ALLOWED_SUBJECTS=
# SSHHUB_OIDC_LABEL=使用公司账号登录
